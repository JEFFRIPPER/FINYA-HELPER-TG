# Copy this file to .env and fill secrets locally.
# Never commit real Telegram tokens.
TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather
# Stable Telegram ID of @THKC_SQUAD for the automatic channel blacklist.
BLACKLIST_CHANNEL_ID=-1001192817776
# Optional durable state directory. Railway volumes are detected automatically.
# FINYA_STATE_DIR=/data

# Optional: discussion group for activity XP. By default detected from @THKC_SQUAD.
# Owner can also bind it with /xpchat inside the discussion group.
# XP_DISCUSSION_CHAT_ID=-1000000000000
